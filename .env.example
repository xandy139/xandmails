# ========================================================
# CONECTAEMAIL - MONITOR DE CÓDIGO DISNEY+
# ========================================================
#
# COMO OBTER A SENHA DE APLICATIVO DO GMAIL:
# 1. Acesse: https://myaccount.google.com/security
# 2. Ative a "Verificação em duas etapas" (se ainda não estiver ativa).
# 3. Pesquise por "Senhas de app" ou acesse:
#    https://myaccount.google.com/apppasswords
# 4. Dê um nome (ex: "ConectaEmail") e clique em Criar.
# 5. O Google vai gerar uma senha de 16 letras (ex: abcd efgh ijkl mnop).
# 6. Cole abaixo no EMAIL_PASS (pode colar com ou sem espaços).
# ========================================================

# Servidor IMAP do Gmail
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Seu e-mail completo do Gmail
EMAIL_USER=seu_email@gmail.com

# Senha de Aplicativo de 16 caracteres gerada pelo Google
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Intervalo entre verificações em segundos (padrão: 10 segundos)
POLL_INTERVAL=10

# Tempo de exibição e validade do código no site (em minutos, padrão: 15)
CODE_EXPIRATION_MINUTES=15

# Porta do servidor web local
PORT=5000
